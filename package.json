{
  "name": "oh-yes-ad",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/rename-deliverables-to-work-items.ts --execute --deployment && prisma db push && tsx scripts/ensure-work-item-final-index.ts && tsx scripts/backfill-estimation-execution-cost-items.ts && tsx scripts/backfill-initiation-execution-cost-items.ts && tsx scripts/backfill-project-service-content.ts --execute && prisma db seed && tsx scripts/auto-migrate-release-data.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test:project-segment-update": "node --import tsx --test src/lib/project-segment-update.test.ts",
    "migrate:segments-to-briefs:test": "tsx scripts/migrate-segments-to-briefs.ts --test --setup-schema",
    "migrate:segments-to-briefs:production": "tsx scripts/migrate-segments-to-briefs.ts --production",
    "fill:missing-segment-owners:test": "tsx scripts/fill-missing-segment-owners.ts --test",
    "reset:segments-to-briefs:test": "tsx scripts/reset-segments-to-briefs-test.ts",
    "verify:segments-to-briefs:test": "tsx scripts/verify-segments-to-briefs-test.ts",
    "verify:release-data:test": "tsx scripts/verify-release-data.ts --test",
    "verify:release-data:production": "tsx scripts/verify-release-data.ts --production",
    "db:seed": "prisma db seed",
    "backfill:project-service-content": "tsx scripts/backfill-project-service-content.ts",
    "db:sync-prod-to-test": "bash scripts/sync-prod-to-test-db.sh",
    "sync:new-select-option-colors": "tsx scripts/sync-new-select-option-colors.ts",
    "seed:project-cost-estimation-options": "tsx scripts/seed-project-cost-estimation-options.ts",
    "db:rename-work-items": "tsx scripts/rename-deliverables-to-work-items.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/pro-components": "^2.8.10",
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@notionhq/client": "^5.11.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "antd": "^6.3.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "rc-field-form": "^2.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
